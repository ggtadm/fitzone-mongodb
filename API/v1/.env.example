# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube a git (contiene credenciales).

# MongoDB Atlas (nube): copie la cadena desde Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MongoDB local (alternativa):
# MONGO_URI=mongodb://localhost:27017

MONGO_DB=fitzone_db

# Token que los clientes deben enviar en: Authorization: Bearer <API_TOKEN>
API_TOKEN=cambie-este-token

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
